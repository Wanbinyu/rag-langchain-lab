# DeepSeek（Chat）+ 本地 Embedding（推荐：DeepSeek 无官方 embedding API）
OPENAI_API_KEY=your-deepseek-key
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_CHAT_MODEL=deepseek-v4-flash
EMBEDDING_PROVIDER=local
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
QUERY_EXPANSION_ENABLED=1
# Keep the original question and append domain terminology for cross-language reranking.
RERANKER_USE_EXPANDED_QUERY=1
QUERY_BOUNDARY_GUARD_ENABLED=1
# Candidate-size controls. Balanced profile validated on the 85-question set.
RETRIEVAL_CANDIDATE_MULTIPLIER=3
RETRIEVAL_CANDIDATE_MIN=9
RETRIEVAL_CANDIDATE_MAX=18
LEXICAL_CANDIDATE_LIMIT=3
LEXICAL_PROVIDER=bm25
HYBRID_RETRIEVAL_ENABLED=1
BM25_CANDIDATE_LIMIT=6
BM25_TITLE_BOOST=0.2
HYBRID_CANDIDATE_POOL=18
RRF_K=60
SOURCE_DIVERSITY_ENABLED=1
MAX_CHUNKS_PER_SOURCE=2
PRIMARY_SOURCE_SCORE_MARGIN=0.08
PRIMARY_SOURCE_ADVANTAGE_MARGIN=0.15
SOURCE_INTRO_ENABLED=1
SOURCE_INTRO_SOURCE_LIMIT=3
SOURCE_INTRO_MIN_CHARS=180
# Keep retrieval metrics on primary hits; use bounded parent/neighbor context for answers.
CONTEXT_EXPANSION_ENABLED=1
CONTEXT_NEIGHBOR_RADIUS=1
CONTEXT_MAX_SOURCES=3
CONTEXT_MAX_CHUNKS=10
PARENT_CHUNK_SIZE=3
RETRIEVAL_RETRY_ENABLED=1
# rule = glossary + multi-signal English topics (default); alias = old expand-only; off = no retry
RETRIEVAL_REWRITE_MODE=rule
# Latency-first: do not second-pass ordinary review hits (already answerable).
RETRIEVAL_RETRY_ON_REVIEW=0
RETRIEVAL_RETRY_SCORE=0.35
# Skip second pass when top score is OOS-like.
RETRIEVAL_RETRY_HOPELESS=0.12
RETRIEVAL_RETRY_TOP_K=6
RETRIEVAL_RETRY_KEEP_ORIGINAL=1
# Only widen the candidate pool on the retry pass (main path stays balanced).
RETRIEVAL_RETRY_WIDEN=1
RETRIEVAL_RETRY_CANDIDATE_MIN=12
RETRIEVAL_RETRY_CANDIDATE_MAX=28
RETRIEVAL_RETRY_BM25_LIMIT=10
RETRIEVAL_RETRY_HYBRID_POOL=28
# Reuse cross-encoder scores for identical (query, document) pairs in-process.
RERANK_PAIR_CACHE_ENABLED=1
ANSWER_POINT_COVERAGE_THRESHOLD=0.35
INDEX_INCLUDE_METADATA=0

# 若改用 OpenAI 官方（Chat + Embedding 都走云端）：
# Cross-Encoder Reranker (the multilingual model is downloaded on first query)
# Official endpoint is the tested default. A compatible mirror may be used
# when needed, but some mirrors do not expose every ONNX model artifact.
HF_ENDPOINT=https://huggingface.co
# Avoid Hugging Face Xet CAS 401 failures on some networks/mirrors.
HF_HUB_DISABLE_XET=1
RERANKER_PROVIDER=local
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Calibrated on the development set 2026-08-12: knowledge >=0.333, OOS <=0.21.
RERANKER_SUFFICIENT_THRESHOLD=0.52
RERANKER_REVIEW_THRESHOLD=0.30
RERANKER_MIN_MARGIN=0.04
RERANKER_SOFT_REVIEW_FLOOR=0.28
EVIDENCE_SAME_SOURCE_SUPPORT=1
FRAGMENT_PRIMARY_REPAIR_ENABLED=1
FRAGMENT_MAX_CHARS=100

# OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai-compatible
# OPENAI_EMBED_MODEL=text-embedding-3-small
